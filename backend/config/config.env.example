# Copy to config.env for local development. On Vercel these come from the project's
# environment variables (MONGODB_URI and BLOB_READ_WRITE_TOKEN are added by the integrations).
PORT=4000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
# Vercel Blob store token, used for listing and profile photos
BLOB_READ_WRITE_TOKEN=
# Optional: password-reset emails
FRONTEND_URL=http://localhost:3000
SMPT_SERVICE=gmail
SMPT_MAIL=
SMPT_PASSWORD=
